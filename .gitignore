# Ignore sibling tools' code and internals, keeping only their README.md files
/netman/*
!/netman/README.md
!/netman/readme.md

/logit/*
!/logit/README.md
!/logit/readme.md

/progit/*
!/progit/README.md
!/progit/readme.md

/sodo/*
!/sodo/README.md
!/sodo/readme.md

/sudow/*
!/sudow/README.md
!/sudow/readme.md

/frog/*
!/frog/README.md
!/frog/readme.md

# Ignore build artifacts
target/
tom/target/
**/target/
